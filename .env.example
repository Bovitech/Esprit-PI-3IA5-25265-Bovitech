# Bovitech — copy this file to .env at the repo root (never commit .env)

# --- Mobile app (Expo / main-bovitech-main) ---
EXPO_PUBLIC_API_BASE_URL=http://127.0.0.1:8008
EXPO_PUBLIC_AUTH_BASE_URL=http://127.0.0.1:8000
# EXPO_PUBLIC_CHATBOT_API_BASE_URL=http://127.0.0.1:8000
# EXPO_PUBLIC_DASHBOARD_BASE_URL=http://127.0.0.1:8008
# EXPO_PUBLIC_API_HTTP_TIMEOUT_MS=120000
# EXPO_PUBLIC_API_VOCAL_TIMEOUT_MS=180000

# --- PI_Backend + Chatbot (Django — shared; only one service on :8000 at a time) ---
SECRET_KEY=change-me-generate-random-string
DEBUG=True
ALLOWED_HOSTS=127.0.0.1,localhost

# --- Chatbot (optional — Groq LLM + skin agent) ---
GROQ_API_KEY=
CORS_ALLOWED_ORIGINS=http://127.0.0.1:8000,http://localhost:8000,http://127.0.0.1:8081,http://localhost:8081

# --- ML inference API (model_http_api.py) ---
# SKIP_MODEL_DOWNLOAD=1
STRESS_V3_CHECKPOINT=finale_model/StressDetectionV3_trained.pt
VOCAL_MODEL_PATH=finale_model/model_audio_classification (1).h5
ILLNESS_PPO_PATH=finale_model/illness_ppo.zip
TRAJECTORY_CHECKPOINT=gps_tracking/models/lstm_all.pth
TRAJECTORY_SCALER=gps_tracking/models/scaler_all.pkl
UWB_DATA_DIR=gps_tracking/uwb_data

# FFMPEG_PATH=C:/ffmpeg/bin/ffmpeg.exe
# VOCAL_SAMPLE_RATE=22050
# VOCAL_FFMPEG_TIMEOUT_SEC=90
